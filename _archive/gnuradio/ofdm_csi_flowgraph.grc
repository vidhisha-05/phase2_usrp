    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Custom 128-pt OFDM PHY real-time CSI sensing
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
